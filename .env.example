# ==========================
# LapAgent runtime settings
# ==========================

# Backend server
LAPAGENT_HOST=0.0.0.0
LAPAGENT_PORT=8000
LAPAGENT_RELOAD=true

# CORS (comma-separated list)
LAPAGENT_CORS_ORIGINS=http://localhost:5173

# Logging
LAPAGENT_LOG_LEVEL=INFO
LAPAGENT_LOG_DIR=logs
LAPAGENT_LOG_MAX_BYTES=10485760
LAPAGENT_LOG_BACKUP_COUNT=5

# AI provider/model routing
# If LAPAGENT_API_BASE_URL is set, it has highest priority.
# Otherwise base_url_dict + LAPAGENT_API_PROVIDER will be used.
LAPAGENT_API_PROVIDER=OpenAI
LAPAGENT_API_MODEL=
LAPAGENT_API_BASE_URL=

# Secrets (prefer env var or secret file path in production)
LAPAGENT_API_KEY=
LAPAGENT_API_KEY_FILE=

# Self-hosted SearXNG search endpoint (JSON format must be enabled in SearXNG).
# For a backend running in Docker, use the SearXNG service name instead of localhost.
LAPAGENT_SEARXNG_URL=http://localhost:8080

# Database and crypto key paths
# Can be absolute paths, or relative paths (relative to backend/Database and backend/Crypto modules respectively).
LAPAGENT_DB_PATH=../Database/LapAgent.db
LAPAGENT_CRYPT_KEY_PATH=../Database/secret.key

# Web crawl settings
